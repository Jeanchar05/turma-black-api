Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^((dashboard|atividades|notificacoes|estudo(?:-[a-z0-9-]+)?|modulos|minigames|gestao|notas|favoritos|provas|roleta|roleta-reel)(\.html)?)$ /__premium/$1 [END,QSA,NC]
RewriteRule ^((protected-estudo\.js|estudo\.(js|css)|estudo-[^/]+\.(js|css)|study-[^/]+\.(js|css)|module-lab-[^/]+\.(js|css)|modules-v16[^/]*\.(js|css)|modules-elite-[^/]*\.(js|css)|modules-images-[^/]*\.js|modules-page-[^/]*\.js|modulos\.(js|css)|gestao-[^/]+\.(js|css)|notas(?:-[^/]+)?\.(js|css)|favorites-[^/]+\.(js|css)|favoritos\.(js|css)|provas(?:-[^/]+)?\.(js|css)|exams-[^/]+\.(js|css)|roleta(?:-reel)?[^/]*\.(js|css)|race-tool\.js|study-race-[^/]+\.js|dashboard-(?:premium|final|lite|controls-[^/]*|notifications-[^/]*|portrait-[^/]*|v20[^/]*|refine-[^/]*|safe-[^/]*|hero-[^/]*|live-[^/]*|character-[^/]*)\.(js|css)|elite-v19(?:-addons)?\.js))$ /__premium/$1 [END,QSA,NC]
RewriteRule ^dashboard-neo/(.+)$ /__premium/dashboard-neo/$1 [END,QSA,NC]
RewriteRule ^assets/(study|roulette|minigames|gestao|exams|modules-v16|elite-v19/modules|imperial-v14/modules)/(.+)$ /__premium/assets/$1/$2 [END,QSA,NC]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Security-Policy-Version "20260909-3"
Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://pay.turmablack.com.br; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src 'none'; worker-src 'self' blob:; media-src 'self' blob: https:; manifest-src 'self'; upgrade-insecure-requests"
</IfModule>
