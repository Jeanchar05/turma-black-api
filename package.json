{
  "name": "turma-do-primo-api",
  "version": "4.4.0",
  "description": "Plataforma Turma do Primo com frontend, backend, MySQL e notificações push integrados na Hostinger",
  "main": "server.js",
  "engines": { "node": "22.x" },
  "scripts": {
    "postinstall": "node scripts/patch-ui-v10.js",
    "start": "node scripts/patch-ui-v10.js && node scripts/validate.js && node server.js",
    "dev": "node scripts/patch-ui-v10.js && nodemon server.js",
    "validate": "node scripts/validate.js",
    "test": "npm run validate"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.0.0",
    "mysql2": "^3.14.3",
    "pdfkit": "^0.15.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": { "nodemon": "^3.1.9" }
}
