# Segurança / ambiente
NODE_ENV=production
# Use uma chave aleatória única com pelo menos 32 caracteres. Nunca publique o valor real.
JWT_SECRET=troque-por-uma-chave-aleatoria-segura-com-32-ou-mais-caracteres
# Origens permitidas para chamadas da API no navegador, separadas por vírgula.
ALLOWED_ORIGINS=https://turmablack.com.br,https://www.turmablack.com.br

# Bootstrap administrativo deve permanecer DESATIVADO após a instalação.
ENABLE_SETUP_SUPERADMIN=false
# Só é lido quando ENABLE_SETUP_SUPERADMIN=true. Use um segredo diferente do JWT_SECRET.
SETUP_SECRET=troque-por-uma-chave-de-setup-separada-com-32-ou-mais-caracteres

# Banco MySQL da própria Hostinger
DB_HOST=srv0000.hstgr.io
DB_PORT=3306
DB_NAME=u000000000_TurmaBlack
DB_USER=u000000000_TurmaBlack
DB_PASSWORD=troque-pela-senha-do-mysql
# Alternativa segura para senhas com caracteres especiais:
# DB_PASSWORD_BASE64=

# Bestfy
# Cole a chave secreta diretamente nas variáveis de ambiente da Hostinger.
# Nunca publique a chave real no GitHub.
BESTFY_API_KEY=cole-a-chave-secreta-da-bestfy-aqui
# Opcional. Se omitido, o sistema descobre e valida o companyId usando a API Key.
BESTFY_COMPANY_ID=

# Conta Dev
DEV_EMAIL=dev@turmablack.com
# Obrigatória para criar/atualizar automaticamente a conta Dev. Mínimo de 12 caracteres.
# Não reutilize JWT_SECRET, SETUP_SECRET nem credenciais do banco/Bestfy.
DEV_PASSWORD=troque-por-uma-senha-dev-forte-e-exclusiva

# Reconexão do banco (opcional)
DB_RETRY_MS=30000

# Não utilize MONGO_URL, API_URL do Render ou URLs onrender.com.
# Frontend, API, notificações e banco funcionam no domínio da Hostinger.
